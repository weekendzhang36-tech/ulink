page {
  min-height: 100%;
  color: #111114;
  background: #f2f2f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.page {
  padding: 24rpx 28rpx 48rpx;
}

.card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.18;
}

.subtitle,
.muted {
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.5;
}

.primary-button {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #ffffff;
  background: #007aff;
  font-size: 32rpx;
  font-weight: 800;
}

.secondary-button {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  font-size: 32rpx;
  font-weight: 800;
}
