.hero {
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}

.info-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(60, 60, 67, 0.16);
  font-size: 30rpx;
}

.info-row:first-child {
  border-top: 0;
}

.row-value {
  max-width: 430rpx;
  color: #111114;
  font-weight: 700;
  text-align: right;
}

.section-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.compact {
  margin-top: 28rpx;
}
