<view class="page">
  <view class="card hero">
    <text class="eyebrow">学生资料</text>
    <view class="title">完善基础信息</view>
    <view class="subtitle">资料用于认证确认、活动签到和会员权益核销。</view>
  </view>

  <view class="card form-card">
    <view class="form-row">
      <text>真实姓名</text>
      <input data-key="realName" value="{{realName}}" placeholder="请输入真实姓名" bindinput="changeText" />
    </view>
    <view class="form-row">
      <text>手机号</text>
      <view class="phone-status">
        <text class="phone-value {{phoneVerified ? 'is-verified' : ''}}">{{phone || '未认证'}}</text>
      </view>
    </view>
    <view class="phone-methods">
      <button class="method-button {{phoneAuthMethod === 'wechat' ? 'is-active' : ''}}" data-method="wechat" bindtap="changePhoneAuthMethod">
        微信授权
      </button>
      <button class="method-button {{phoneAuthMethod === 'sms' ? 'is-active' : ''}}" data-method="sms" bindtap="changePhoneAuthMethod">
        短信验证
      </button>
    </view>
    <view wx:if="{{phoneAuthMethod === 'wechat'}}" class="phone-panel">
      <button class="phone-button" open-type="getPhoneNumber" bindgetphonenumber="getWechatPhone">
        {{phoneVerified ? '重新授权手机号' : '授权微信手机号'}}
      </button>
    </view>
    <view wx:else class="phone-panel sms-panel">
      <view class="sms-row">
        <input data-key="smsPhone" value="{{smsPhone}}" type="number" maxlength="11" placeholder="请输入手机号" bindinput="changeText" />
        <button class="sms-code-button" loading="{{loading}}" bindtap="requestSmsCode">
          {{smsCodeSent ? '重新获取' : '获取验证码'}}
        </button>
      </view>
      <view class="sms-row">
        <input data-key="smsCode" value="{{smsCode}}" type="number" maxlength="6" placeholder="请输入短信验证码" bindinput="changeText" />
        <button class="sms-code-button verify" loading="{{loading}}" bindtap="verifySmsCode">确认验证</button>
      </view>
    </view>
    <view class="form-row">
      <text>性别</text>
      <picker range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="changeGender">
        <view class="picker-value">{{genderOptions[genderIndex].label}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text>生日</text>
      <picker mode="date" value="{{birthday}}" bindchange="changeBirthday">
        <view class="picker-value">{{birthday || '请选择生日'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text>学校</text>
      <picker data-key="school" range="{{campus.schools}}" range-key="name" value="{{indexes.school}}" bindchange="changePicker">
        <view class="picker-value">{{selectedLabels.school}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text>学院</text>
      <picker data-key="college" range="{{campus.colleges}}" range-key="name" value="{{indexes.college}}" bindchange="changePicker">
        <view class="picker-value">{{selectedLabels.college}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text>专业</text>
      <picker data-key="major" range="{{campus.majors}}" range-key="name" value="{{indexes.major}}" bindchange="changePicker">
        <view class="picker-value">{{selectedLabels.major}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text>班级</text>
      <picker data-key="class" range="{{campus.classes}}" range-key="name" value="{{indexes.class}}" bindchange="changePicker">
        <view class="picker-value">{{selectedLabels.class}}</view>
      </picker>
    </view>
  </view>

  <checkbox-group bindchange="changeAgreed">
    <label class="agreement">
      <checkbox value="agree" checked="{{agreedToPolicies}}" />
      <text>我已阅读并同意用户协议和隐私政策</text>
    </label>
  </checkbox-group>
  <view class="legal-links">
    <text bindtap="openUserAgreement">用户协议</text>
    <text class="separator">|</text>
    <text bindtap="openPrivacyPolicy">隐私政策</text>
  </view>

  <button class="primary-button" loading="{{loading}}" bindtap="submit">提交资料</button>
</view>
