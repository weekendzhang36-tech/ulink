.form-card {
  padding: 0 32rpx;
}

.form-row {
  align-items: center;
  border-bottom: 1rpx solid #e5e5ea;
  display: flex;
  justify-content: space-between;
  min-height: 104rpx;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-row text {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 600;
}

.form-row input,
.picker-value {
  color: #6e6e73;
  font-size: 30rpx;
  max-width: 430rpx;
  text-align: right;
}

.phone-action {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  max-width: 460rpx;
}

.phone-value {
  color: #8e8e93;
  font-size: 28rpx;
  max-width: 250rpx;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-value.is-verified {
  color: #1d1d1f;
  font-weight: 600;
}

.phone-button {
  background: #e8f1ff;
  border-radius: 999rpx;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  margin: 0;
  min-width: 144rpx;
  padding: 0 22rpx;
}

.phone-button::after {
  border: 0;
}

.agreement {
  align-items: center;
  color: #6e6e73;
  display: flex;
  font-size: 26rpx;
  gap: 12rpx;
  margin: 24rpx 8rpx 40rpx;
}
