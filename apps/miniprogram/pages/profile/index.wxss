.form-card {
  padding: 0 32rpx;
}

.form-row {
  align-items: center;
  border-bottom: 1rpx solid #e5e5ea;
  display: flex;
  justify-content: space-between;
  min-height: 104rpx;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-row text {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 600;
}

.form-row input,
.picker-value {
  color: #6e6e73;
  font-size: 30rpx;
  max-width: 430rpx;
  text-align: right;
}

.phone-status {
  align-items: center;
  display: flex;
  justify-content: flex-end;
  max-width: 460rpx;
}

.phone-value {
  color: #8e8e93;
  font-size: 28rpx;
  max-width: 250rpx;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-value.is-verified {
  color: #1d1d1f;
  font-weight: 600;
}

.phone-button {
  background: #e8f1ff;
  border-radius: 999rpx;
  color: #007aff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
  width: 100%;
}

.phone-button::after,
.method-button::after,
.sms-code-button::after {
  border: 0;
}

.phone-methods {
  background: #f2f2f7;
  border-radius: 18rpx;
  display: grid;
  gap: 8rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 24rpx 0 0;
  padding: 8rpx;
}

.method-button {
  background: transparent;
  border-radius: 14rpx;
  color: #6e6e73;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
}

.method-button.is-active {
  background: #ffffff;
  color: #007aff;
}

.phone-panel {
  margin: 20rpx 0 8rpx;
}

.sms-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sms-row {
  align-items: center;
  background: #f8f8fa;
  border-radius: 18rpx;
  display: grid;
  gap: 12rpx;
  grid-template-columns: minmax(0, 1fr) 180rpx;
  min-height: 84rpx;
  padding: 0 12rpx 0 24rpx;
}

.sms-row input {
  color: #1d1d1f;
  font-size: 28rpx;
  min-width: 0;
}

.sms-code-button {
  background: #e8f1ff;
  border-radius: 999rpx;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
}

.sms-code-button.verify {
  background: #007aff;
  color: #ffffff;
}

.agreement {
  align-items: center;
  color: #6e6e73;
  display: flex;
  font-size: 26rpx;
  gap: 12rpx;
  margin: 24rpx 8rpx 40rpx;
}

.legal-links {
  color: #007aff;
  display: flex;
  font-size: 26rpx;
  gap: 18rpx;
  justify-content: center;
  margin: 16rpx 0 26rpx;
}

.separator {
  color: #c7c7cc;
}
