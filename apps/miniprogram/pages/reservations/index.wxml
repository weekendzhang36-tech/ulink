<view class="page">
  <view class="card header-card">
    <view class="eyebrow">成长服务</view>
    <view class="title">我的预约</view>
    <view class="subtitle">查看已预约的活动、实训营和实践机会。</view>
  </view>

  <view wx:if="{{loading}}" class="card empty-card">
    <text>预约加载中</text>
  </view>

  <view wx:elif="{{reservations.length === 0}}" class="card empty-card">
    <view class="empty-title">暂无预约</view>
    <view class="muted">预约活动或实践机会后，会在这里显示记录。</view>
  </view>

  <view wx:else class="reservation-list">
    <view
      wx:for="{{reservations}}"
      wx:key="id"
      class="card reservation-card"
      data-id="{{item.content.id}}"
      bindtap="openContent"
    >
      <view class="reservation-head">
        <view>
          <view class="category">{{item.content.categoryTitle || item.content.module}}</view>
          <view class="reservation-title">{{item.content.title}}</view>
        </view>
        <text class="status">{{item.statusText}}</text>
      </view>

      <view class="summary">{{item.content.summary}}</view>
      <view class="meta-row">
        <text>{{item.reservedDateText}}</text>
        <text wx:if="{{item.tagText}}">{{item.tagText}}</text>
      </view>
      <view class="footer-row">
        <text class="muted">{{item.content.statusText}}</text>
        <text class="muted">›</text>
      </view>
    </view>
  </view>
</view>
