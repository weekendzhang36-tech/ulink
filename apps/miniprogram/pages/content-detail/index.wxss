.hero {
  margin-top: 0;
}

.body-text {
  color: #333333;
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.lock-card {
  background: #f8fbff;
  border: 2rpx solid #dbeaff;
}

.lock-title {
  color: #111111;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.content-flags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.flag {
  background: #f2f2f7;
  border-radius: 999rpx;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
  padding: 0 18rpx;
}

.flag.primary {
  background: #e8f1ff;
  color: #007aff;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tag {
  background: #f2f2f7;
  border-radius: 999rpx;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
  padding: 0 18rpx;
}

.action-button {
  margin-top: 32rpx;
}
