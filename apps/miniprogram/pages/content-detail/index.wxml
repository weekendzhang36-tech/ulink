<view class="page">
  <view class="card hero">
    <text class="eyebrow">{{article.categoryTitle || '成长内容'}}</text>
    <view class="title">{{article.title}}</view>
    <view class="muted">{{article.meta}}</view>
    <view class="subtitle">{{article.summary}}</view>
    <view class="content-flags">
      <text class="flag primary">{{article.statusText}}</text>
      <text class="flag primary" wx:if="{{article.reservation}}">{{article.reservation.statusText}}</text>
      <text class="flag" wx:if="{{article.isMemberOnly}}">会员专属</text>
      <text class="flag" wx:if="{{article.capacityText}}">{{article.capacityText}}</text>
    </view>
    <view class="tag-row" wx:if="{{article.tags && article.tags.length}}">
      <text class="tag" wx:for="{{article.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
    </view>
  </view>

  <view class="card lock-card" wx:if="{{article.isLocked}}">
    <view class="lock-title">会员专属内容</view>
    <view class="body-text">{{article.lockMessage || article.body}}</view>
  </view>

  <view class="card" wx:else>
    <view class="body-text">{{article.body}}</view>
  </view>

  <button
    wx:if="{{article.actionLabel}}"
    class="primary-button action-button"
    bindtap="useAction"
    disabled="{{actionLoading || article.reservation}}"
    loading="{{actionLoading}}"
  >
    {{article.reservation ? article.reservation.statusText : article.actionLabel}}
  </button>
</view>
