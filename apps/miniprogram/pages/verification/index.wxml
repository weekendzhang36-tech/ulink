<view class="page">
  <view class="card">
    <text class="eyebrow">{{state.verificationStatus}}</text>
    <view class="title">学生认证状态</view>
    <view class="subtitle">{{state.message}}</view>
  </view>

  <view class="card">
    <view class="info-row">
      <text>姓名</text>
      <text>{{state.name}}</text>
    </view>
    <view class="info-row">
      <text>学校</text>
      <text>{{state.school}}</text>
    </view>
    <view class="info-row">
      <text>班级</text>
      <text>{{state.className}}</text>
    </view>
  </view>
</view>
