<view class="page">
  <view class="card status-card" bindtap="openVerification">
    <text class="eyebrow">{{studentState.verificationStatus}}</text>
    <view class="title">欢迎来到 U Link</view>
    <view class="subtitle">{{studentState.message}}</view>
  </view>

  <view class="card status-card" wx:if="{{instructorState}}" bindtap="openInstructorVerifications">
    <text class="eyebrow">待认证学生</text>
    <view class="title">{{instructorState.pendingCount}} 位学生待确认</view>
    <view class="subtitle">进入后可查看资料并完成确认。</view>
  </view>

  <view class="card plan-card" bindtap="openGrowthPlan">
    <text class="eyebrow orange">成长计划</text>
    <view class="title">{{growthPlan.title}}</view>
    <view class="price">{{growthPlan.priceText}}</view>
    <view class="subtitle">{{growthPlan.description}}</view>
  </view>

  <view class="section-title">成长模块</view>
  <view class="module-grid">
    <view class="module-card" wx:for="{{modules}}" wx:key="key" data-key="{{item.key}}" data-title="{{item.title}}" bindtap="openModule">
      <view class="module-title">{{item.title}}</view>
      <view class="muted">{{item.summary}}</view>
    </view>
  </view>

  <view class="section-title">近期内容</view>
  <view class="card article-card" wx:for="{{articles}}" wx:key="id" data-id="{{item.id}}" bindtap="openArticle">
    <view class="article-title">{{item.title}}</view>
    <view class="muted">{{item.meta}}</view>
    <view class="subtitle">{{item.summary}}</view>
  </view>
</view>
