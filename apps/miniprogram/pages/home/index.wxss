.status-card {
  margin-top: 0;
}

.orange {
  color: #b35a00;
  background: rgba(255, 149, 0, 0.14);
}

.plan-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff4df 100%);
}

.price {
  margin-top: 12rpx;
  color: #ff9500;
  font-size: 42rpx;
  font-weight: 900;
}

.section-title {
  margin: 34rpx 4rpx 16rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.module-card {
  min-height: 160rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.module-title,
.article-title {
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.25;
}

.article-card {
  margin-top: 18rpx;
}
