<view class="page">
  <view class="card header-card">
    <view class="eyebrow">成长计划</view>
    <view class="title">会员订单</view>
    <view class="subtitle">查看友邻成长计划的订单金额、支付状态和生效记录。</view>
  </view>

  <view wx:if="{{loading}}" class="card empty-card">
    <text>订单加载中</text>
  </view>

  <view wx:elif="{{orders.length === 0}}" class="card empty-card">
    <view class="empty-title">暂无会员订单</view>
    <view class="muted">加入友邻成长计划后，订单和支付状态会显示在这里。</view>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="orderNo" class="card order-card">
      <view class="order-head">
        <view>
          <view class="order-label">友邻成长计划</view>
          <view class="order-no">{{item.orderNo}}</view>
        </view>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="amount-row">
        <text>订单金额</text>
        <text>{{item.amountText}}</text>
      </view>

      <view class="info-row">
        <text class="muted">创建时间</text>
        <text>{{item.createdDateText}}</text>
      </view>
      <view wx:if="{{item.paidDateText}}" class="info-row">
        <text class="muted">支付时间</text>
        <text>{{item.paidDateText}}</text>
      </view>

      <view class="order-action-row">
        <view class="action-hint">{{item.actionState.hintText}}</view>
        <view wx:if="{{item.actionState.type === 'pending'}}" class="action-buttons">
          <button
            class="cancel-button"
            loading="{{cancelingOrderNo === item.orderNo}}"
            disabled="{{cancelingOrderNo === item.orderNo || payingOrderNo === item.orderNo}}"
            data-order-no="{{item.orderNo}}"
            bindtap="cancelOrder"
          >
            {{item.actionState.secondaryAction.label}}
          </button>
          <button
            class="pay-button"
            loading="{{payingOrderNo === item.orderNo}}"
            disabled="{{cancelingOrderNo === item.orderNo || payingOrderNo === item.orderNo}}"
            data-order-no="{{item.orderNo}}"
            bindtap="continuePay"
          >
            {{item.actionState.primaryAction.label}}
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
