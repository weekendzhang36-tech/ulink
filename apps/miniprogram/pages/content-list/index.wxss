.hero {
  margin-top: 0;
}

.empty-card {
  padding: 36rpx;
}

.content-card {
  padding: 32rpx;
}

.content-meta {
  color: #8e8e93;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.content-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 14rpx;
}

.content-flags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.flag {
  background: #f2f2f7;
  border-radius: 999rpx;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
  padding: 0 18rpx;
}

.flag.primary {
  background: #e8f1ff;
  color: #007aff;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  background: #f2f2f7;
  border-radius: 999rpx;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
  padding: 0 18rpx;
}
