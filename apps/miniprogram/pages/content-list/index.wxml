<view class="page">
  <view class="card hero">
    <text class="eyebrow">成长模块</text>
    <view class="title">{{title}}</view>
    <view class="subtitle">这里展示后台已发布的活动、文章、机会和服务入口。</view>
  </view>

  <view wx:if="{{loading}}" class="card empty-card">
    <view class="subtitle">正在加载内容...</view>
  </view>

  <view wx:elif="{{contentEmpty && servicesEmpty}}" class="card empty-card">
    <view class="section-title">暂无已发布内容</view>
    <view class="subtitle">后台发布并启用分类后，会自动显示在这里。</view>
  </view>

  <view wx:else>
    <view wx:if="{{!servicesEmpty}}" class="section-block">
      <view class="section-heading">服务入口</view>
      <view class="service-grid">
        <view class="service-card" wx:for="{{serviceLinks}}" wx:key="id" data-id="{{item.id}}" bindtap="openService">
          <view class="service-type">{{item.typeLabel}}</view>
          <view class="service-title">{{item.title}}</view>
          <view class="service-desc">{{item.description}}</view>
          <view class="service-action">{{item.actionLabel}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!contentEmpty}}" class="section-block">
      <view class="section-heading">最新内容</view>
    </view>
    <view class="card content-card" wx:for="{{contents}}" wx:key="id" data-id="{{item.id}}" bindtap="openContent">
      <view class="content-meta">{{item.categoryTitle}} · {{item.meta}}</view>
      <view class="content-title">{{item.title}}</view>
      <view class="subtitle">{{item.summary}}</view>
      <view class="content-flags">
        <text class="flag primary">{{item.statusText}}</text>
        <text class="flag" wx:if="{{item.isMemberOnly}}">会员专属</text>
        <text class="flag" wx:if="{{item.capacityText}}">{{item.capacityText}}</text>
      </view>
      <view class="tag-row" wx:if="{{item.tags && item.tags.length}}">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
    </view>
  </view>
</view>
