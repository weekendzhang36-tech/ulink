.filter-card {
  background: #ffffff;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  padding: 18rpx;
}

.status-filter {
  background: #f2f2f7;
  border-radius: 22rpx;
  display: grid;
  gap: 4rpx;
  grid-template-columns: repeat(4, 1fr);
  padding: 4rpx;
}

.filter-chip {
  background: transparent;
  border-radius: 18rpx;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  min-width: 0;
  padding: 0;
}

.filter-chip::after {
  border: 0;
}

.filter-chip.active {
  background: #ffffff;
  color: #007aff;
}

.class-filter {
  align-items: center;
  border-top: 1rpx solid #e5e5ea;
  color: #1d1d1f;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 22rpx 12rpx 6rpx;
}

.section-title {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.section-meta {
  color: #8e8e93;
  font-size: 24rpx;
  font-weight: 700;
}

.student-card {
  padding: 28rpx 32rpx;
}

.student-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.student-name {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
}

.status-pill {
  background: #eaf3ff;
  border-radius: 999rpx;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
}

.info-line {
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.7;
}

.action-row {
  display: grid;
  gap: 20rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 24rpx;
}

.secondary-button,
.primary-small-button {
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.secondary-button {
  background: #f2f2f7;
  color: #6e6e73;
}

.secondary-button.full {
  margin-top: 28rpx;
  width: 100%;
}

.primary-small-button {
  background: #007aff;
  color: #ffffff;
}

.empty-card {
  background: #ffffff;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  padding: 36rpx 32rpx;
}

.commitment-card {
  padding: 32rpx;
}

.commitment-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.commitment-text {
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.65;
  margin-bottom: 28rpx;
}
