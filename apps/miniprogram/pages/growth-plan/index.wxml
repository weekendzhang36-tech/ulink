<view class="page">
  <view class="card hero">
    <text class="eyebrow">半年权益</text>
    <view class="title">{{plan.title}}</view>
    <view class="price">{{plan.priceText}}</view>
    <view class="subtitle">{{plan.description}}</view>
  </view>

  <view class="card">
    <view class="section-title">有效期内会收到什么</view>
    <view class="benefit" wx:for="{{plan.benefits}}" wx:key="*this">{{item}}</view>
  </view>

  <view wx:if="{{membershipState}}" class="card membership-card">
    <view>
      <view class="section-title">当前状态</view>
      <view class="membership-desc">{{membershipState.expiresText}}</view>
    </view>
    <text class="membership-status {{membershipState.isActive ? 'is-active' : ''}}">
      {{membershipState.statusText}}
    </text>
  </view>

  <button
    class="primary-button join-button"
    disabled="{{actionState.disabled}}"
    loading="{{loading}}"
    bindtap="joinPlan"
  >
    {{actionState.label}}
  </button>
  <view class="action-hint">{{actionState.hintText}}</view>
</view>
