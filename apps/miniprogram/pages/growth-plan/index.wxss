.hero {
  margin-top: 0;
  background: linear-gradient(135deg, #ffffff 0%, #fff4df 100%);
}

.price {
  margin-top: 12rpx;
  color: #ff9500;
  font-size: 44rpx;
  font-weight: 900;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.benefit {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(60, 60, 67, 0.16);
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.5;
}

.benefit:first-of-type {
  border-top: 0;
}

.membership-card {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.membership-card .section-title {
  margin-bottom: 8rpx;
}

.membership-desc {
  color: #6e6e73;
  font-size: 26rpx;
  line-height: 1.45;
}

.membership-status {
  background: #f2f2f7;
  border-radius: 999rpx;
  color: #6e6e73;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 48rpx;
  padding: 0 20rpx;
}

.membership-status.is-active {
  background: #e8f1ff;
  color: #007aff;
}

.join-button {
  margin-top: 30rpx;
}

.join-button[disabled] {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
}

.action-hint {
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 14rpx;
  padding: 0 12rpx 32rpx;
  text-align: center;
}
