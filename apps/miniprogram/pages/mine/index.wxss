.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(160deg, #26d4c4, #0496a6);
  font-size: 40rpx;
  font-weight: 900;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 900;
}

.list-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(60, 60, 67, 0.16);
  font-size: 30rpx;
}

.list-row:first-child {
  border-top: 0;
}
