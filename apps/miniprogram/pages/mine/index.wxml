<view class="page">
  <view class="card profile">
    <view class="avatar">{{avatarText}}</view>
    <view>
      <view class="profile-name">{{state.name}}</view>
      <view class="muted">{{state.className}}</view>
    </view>
  </view>

  <view class="card membership-card">
    <view>
      <view class="membership-title">友邻成长计划</view>
      <view class="membership-desc">{{state.membershipState.expiresText}}</view>
    </view>
    <view class="membership-side">
      <text class="membership-status {{state.membershipState.isActive ? 'is-active' : ''}}">
        {{state.membershipState.statusText}}
      </text>
      <button wx:if="{{!state.membershipState.isActive}}" class="membership-button" bindtap="openGrowthPlan">
        去加入
      </button>
    </view>
  </view>

  <view class="card benefits-card" wx:if="{{membershipBenefits.length}}">
    <view class="benefits-title">{{state.membershipState.isActive ? '当前权益' : '加入后可获得'}}</view>
    <view class="benefit-row" wx:for="{{membershipBenefits}}" wx:key="*this">
      <text class="benefit-dot"></text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="card list">
    <view class="list-row" bindtap="openVerification">
      <text>认证状态</text>
      <text class="muted">{{state.verificationStatus}}</text>
    </view>
    <view class="list-row" wx:if="{{state.canManageStudents}}" bindtap="openInstructorVerifications">
      <text>学生认证管理</text>
      <text class="muted">›</text>
    </view>
    <view class="list-row" bindtap="openOrders">
      <text>会员订单</text>
      <text class="muted">›</text>
    </view>
    <view class="list-row" bindtap="openReservations">
      <text>我的预约</text>
      <text class="muted">›</text>
    </view>
    <view class="list-row" bindtap="openLegal">
      <text>协议与隐私</text>
      <text class="muted">›</text>
    </view>
  </view>

  <view class="card list danger-list">
    <view class="list-row danger-row" bindtap="signOut">
      <text>退出登录</text>
    </view>
  </view>
</view>
