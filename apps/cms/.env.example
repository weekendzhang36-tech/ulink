DATABASE_URL=postgres://ulink:ulink_dev_password@localhost:5432/ulink
PAYLOAD_SECRET=replace-with-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# 微信小程序配置。生产环境必须配置真实 AppID/AppSecret。
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# 微信支付配置。生产环境必须配置真实商户号、证书、公钥、APIv3 密钥和回调地址。
# WECHAT_PAY_PRIVATE_KEY / WECHAT_PAY_PLATFORM_PUBLIC_KEY 可使用带 \n 的单行 PEM 字符串，部署时放在环境变量或密钥管理中。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=

# 微信小程序订阅消息。字段映射必须按微信后台已审核模板的关键词配置。
WECHAT_SUBSCRIBE_MINIPROGRAM_STATE=formal
WECHAT_SUBSCRIBE_STUDENT_VERIFICATION_RESULT_PAGE=pages/verification/index
WECHAT_SUBSCRIBE_STUDENT_VERIFICATION_RESULT_FIELDS=
WECHAT_SUBSCRIBE_INSTRUCTOR_PENDING_VERIFICATION_PAGE=pages/instructor-verifications/index
WECHAT_SUBSCRIBE_INSTRUCTOR_PENDING_VERIFICATION_FIELDS=

# PayloadCMS 上传文件。生产环境必须配置 COS，避免内容封面、附件等在重新部署后丢失。
# 腾讯云 COS 使用 S3 兼容 API：COS_ENDPOINT 通常形如 https://cos.<region>.myqcloud.com。
COS_BUCKET=
COS_REGION=
COS_ENDPOINT=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PREFIX=ulink-media
COS_PUBLIC_BASE_URL=

# 仅用于本地开发。生产环境必须配置真实微信登录、手机号授权和微信支付。
MINIPROGRAM_MOCK_WECHAT_LOGIN=true
MINIPROGRAM_MOCK_WECHAT_PHONE=true
MINIPROGRAM_MOCK_PHONE=13800000001
MINIPROGRAM_MOCK_SMS=true
MINIPROGRAM_MOCK_SMS_CODE=123456
MINIPROGRAM_MOCK_PAYMENT=true
