DATABASE_URL=postgres://ulink:ulink_dev_password@localhost:5432/ulink
PAYLOAD_SECRET=replace-with-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# 微信小程序配置。生产环境必须配置真实 AppID/AppSecret。
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# 微信支付配置。生产环境必须配置真实商户号、证书序列号、商户私钥和回调地址。
# WECHAT_PAY_PRIVATE_KEY 可使用带 \n 的单行 PEM 字符串，部署时放在环境变量或密钥管理中。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=

# 仅用于本地开发。生产环境必须配置真实微信登录、手机号授权和微信支付。
MINIPROGRAM_MOCK_WECHAT_LOGIN=true
MINIPROGRAM_MOCK_WECHAT_PHONE=true
MINIPROGRAM_MOCK_PHONE=13800000001
MINIPROGRAM_MOCK_PAYMENT=true
