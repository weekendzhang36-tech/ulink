{
  "name": "ulink",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev:cms": "pnpm --filter @ulink/cms dev",
    "dev:miniprogram": "pnpm --filter @ulink/miniprogram dev",
    "import:campus": "pnpm --filter @ulink/cms import:campus",
    "typecheck": "pnpm --filter @ulink/cms typecheck",
    "lint": "pnpm --filter @ulink/cms lint",
    "test:cms": "pnpm --filter @ulink/cms test",
    "test:miniprogram": "node --test apps/miniprogram/**/*.test.js",
    "verify:cms": "pnpm test:cms && pnpm typecheck && pnpm lint",
    "check:miniprogram:js": "find apps/miniprogram -name '*.js' -exec node --check {} \\;",
    "check:miniprogram:json": "find apps/miniprogram -name '*.json' -exec node -e 'JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\"))' {} \\;",
    "verify:miniprogram": "pnpm test:miniprogram && pnpm check:miniprogram:js && pnpm check:miniprogram:json",
    "verify": "pnpm verify:cms && pnpm verify:miniprogram",
    "verify:precommit": "pnpm verify && git diff --check"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
